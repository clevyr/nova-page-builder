{
    "name": "clevyr/nova-page-builder",
    "description": "A Clevyr built Nova Page Builder Resource",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Grant Vinson",
            "email": "grant@clevyr.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "laravel/nova": "^5.0",
        "whitecube/nova-flexible-content": "^2.0",
        "clevyr/nova-filemanager": "^5.0",
        "outl1ne/nova-menu-builder": "^8.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0"
    },
    "suggest": {
        "murdercode/nova4-tinymce-editor": "Required (^2.0) only if you use the default published Default.php page stub, which renders TinymceEditor fields. Swap or override the stub to use any other rich-text field."
    },
    "autoload": {
        "psr-4": {
            "Clevyr\\NovaPageBuilder\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clevyr\\NovaPageBuilder\\NovaPageBuilderServiceProvider"
            ],
            "aliases": {
                "NovaPageBuilder": "Clevyr\\NovaPageBuilder\\Facades\\NovaPageBuilder"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.8|^11.0",
        "laravel/nova-devtool": "^1.9",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "murdercode/nova4-tinymce-editor": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "Clevyr\\NovaPageBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/testbench package:test -p",
        "lint": "@php vendor/bin/phpstan analyze",
        "format": "@php vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
